# Backend — variables pour la PRODUCTION sur le VPS Contabo
# À copier vers backend/.env sur le serveur (remplace le contenu existant).
# Remplace TOUTES les valeurs ci-dessous par les tiennes.

# Base PostgreSQL installée sur le même VPS (voir DEPLOYMENT.md, étape PostgreSQL)
DATABASE_URL="postgresql://masjid_user:VOTRE_MOT_DE_PASSE_DB@localhost:5432/masjid_al_nour?schema=public"

# Notifications push — génère ces clés une seule fois avec :
#   npx web-push generate-vapid-keys
VAPID_SUBJECT="mailto:contact@votredomaine.com"
VAPID_PUBLIC_KEY="colle-ici-la-cle-publique-generee"
VAPID_PRIVATE_KEY="colle-ici-la-cle-privee-generee"

PORT=3000

# Domaine(s) autorisés à appeler l'API (celui de ton site, en HTTPS)
CORS_ORIGIN=https://votredomaine.com
