# Service systemd — backend NestJS de Masjid Al Nour
# À copier vers /etc/systemd/system/masjid-backend.service
#
# Ensuite :
#   sudo systemctl daemon-reload
#   sudo systemctl enable masjid-backend    (démarrage automatique au boot)
#   sudo systemctl start masjid-backend
#   sudo systemctl status masjid-backend    (vérifier que ça tourne)
#   sudo journalctl -u masjid-backend -f    (voir les logs en direct)

[Unit]
Description=Masjid Al Nour - Backend API
After=network.target postgresql.service

[Service]
Type=simple
User=masjid
WorkingDirectory=/var/www/masjid/backend
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
EnvironmentFile=/var/www/masjid/backend/.env

[Install]
WantedBy=multi-user.target
