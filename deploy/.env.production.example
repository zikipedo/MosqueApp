# Frontend — variables pour le build de PRODUCTION (VPS Contabo + domaine + HTTPS)
# À copier vers .env.production à la racine du projet (à côté de package.json)
# avant de lancer "npm run build" sur le serveur.
#
# Remplace votredomaine.com par ton vrai nom de domaine.

# Le backend est servi par Nginx sous /api sur le même domaine (voir deploy/nginx.conf)
VITE_API_URL=https://votredomaine.com/api

# URL publique complète du site — utilisée pour générer le QR code de l'app mobile
VITE_PUBLIC_URL=https://votredomaine.com

VITE_MOSQUE_ID=masjid-al-nour
