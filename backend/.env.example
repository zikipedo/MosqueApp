# Copie ce fichier en .env et adapte les valeurs à ta base PostgreSQL locale (gérée avec pgAdmin4).
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE?schema=public
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/masjid_al_nour?schema=public"
VAPID_SUBJECT="mailto:admin@masjid-al-nour.ml"
VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with-npx-web-push-generate-vapid-keys"
PORT=3000
CORS_ORIGIN=http://localhost:5173
